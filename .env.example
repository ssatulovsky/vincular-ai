# Copie este archivo a .env y complete los valores. Nunca suba .env al repositorio.

NODE_ENV=development
PUERTO=3000
HOST=127.0.0.1

# Conexión de la aplicación (rol vincular_app) y de las migraciones (rol vincular_owner).
DATABASE_URL=postgres://vincular_app:app_local@localhost:5432/vincular
DATABASE_URL_MIGRACIONES=postgres://vincular_owner:owner_local@localhost:5432/vincular

# Cifrado en reposo de textos de conversación y datos de salud: openssl rand -hex 32
CLAVE_CIFRADO=

# ── Modelos de lenguaje ──────────────────────────────────────────────────────────────
# Proveedor por defecto: gemini | anthropic. Cada tarea puede usar otro con IA_PROVEEDOR_<TAREA>.
# Antes de producción: acuerdo de no uso para entrenamiento y retención mínima con el proveedor.
IA_PROVEEDOR=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Modelo por tarea. Para ver los modelos disponibles con su clave: npm run ia:modelos
# Conversación e informes: un modelo de alta calidad. Guardián, riesgo y extracción: uno rápido.
IA_MODELO_CONVERSACION=
IA_MODELO_GUARDIAN=
IA_MODELO_RIESGO=
IA_MODELO_EXTRACCION=
IA_MODELO_INFORMES=

# Ejemplo para usar Claude en todo:
# IA_PROVEEDOR=anthropic
# IA_MODELO_CONVERSACION=claude-sonnet-5-5
# IA_MODELO_GUARDIAN=claude-haiku-5-5
# IA_MODELO_RIESGO=claude-haiku-5-5
# IA_MODELO_EXTRACCION=claude-haiku-5-5
# IA_MODELO_INFORMES=claude-opus-5-5

# Ejemplo mixto: conversación con Gemini, guardián con Claude.
# IA_PROVEEDOR_GUARDIAN=anthropic

# Espera máxima al clasificador de riesgo antes de responder con el nivel de las reglas.
RIESGO_ESPERA_CLASIFICADOR_MS=4000
