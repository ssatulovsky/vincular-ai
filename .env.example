# Copie este archivo a .env y complete los valores. Nunca suba .env al repositorio.

NODE_ENV=development
PUERTO=3000
HOST=127.0.0.1

# Conexión de la aplicación (rol vincular_app) y de las migraciones (rol vincular_owner).
DATABASE_URL=postgres://vincular_app:app_local@localhost:5432/vincular
DATABASE_URL_MIGRACIONES=postgres://vincular_owner:owner_local@localhost:5432/vincular

# Cifrado en reposo de textos de conversación y datos de salud: openssl rand -hex 32
CLAVE_CIFRADO=

# ── Modelos de lenguaje ──────────────────────────────────────────────────────────────
# Proveedor por defecto: gemini | anthropic. Cada tarea puede usar otro con IA_PROVEEDOR_<TAREA>.
# Antes de producción: acuerdo de no uso para entrenamiento y retención mínima con el proveedor.
IA_PROVEEDOR=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Modelo por tarea. Para ver los modelos disponibles con su clave: npm run ia:modelos
# Conversación e informes: un modelo de alta calidad. Guardián, riesgo y extracción: uno rápido.
IA_MODELO_CONVERSACION=
IA_MODELO_GUARDIAN=
IA_MODELO_RIESGO=
IA_MODELO_EXTRACCION=
IA_MODELO_INFORMES=
# Embeddings de la memoria episódica (vector de 768 dimensiones). Claude no ofrece embeddings:
# si usa Claude para todo, deje IA_PROVEEDOR_EMBEDDINGS=gemini o vacíe el modelo y la búsqueda
# en conversaciones anteriores se hará por palabras.
IA_PROVEEDOR_EMBEDDINGS=gemini
IA_MODELO_EMBEDDINGS=

# Ejemplo para usar Claude en todo:
# IA_PROVEEDOR=anthropic
# IA_MODELO_CONVERSACION=claude-sonnet-5-5
# IA_MODELO_GUARDIAN=claude-haiku-5-5
# IA_MODELO_RIESGO=claude-haiku-5-5
# IA_MODELO_EXTRACCION=claude-haiku-5-5
# IA_MODELO_INFORMES=claude-opus-5-5

# Ejemplo mixto: conversación con Gemini, guardián con Claude.
# IA_PROVEEDOR_GUARDIAN=anthropic

# Espera máxima al clasificador de riesgo antes de responder con el nivel de las reglas.
RIESGO_ESPERA_CLASIFICADOR_MS=4000

# Minutos sin turnos nuevos para dar por terminada una sesión y extraer su memoria.
MEMORIA_MINUTOS_INACTIVIDAD=30

# ── Voz (Sprint 3) ───────────────────────────────────────────────────────────────────
# Google: cuenta de servicio (necesaria para Chirp 3 STT y Gemini-TTS) o clave de API (sirve
# para las voces Chirp 3 HD).
VOZ_GOOGLE_CUENTA_SERVICIO=
VOZ_GOOGLE_CLAVE_API=
VOZ_GOOGLE_PROYECTO=
# Modelo de Gemini-TTS para las voces con motor "gemini" (ver la documentación vigente de Google).
VOZ_GOOGLE_MODELO_GEMINI=
VOZ_GOOGLE_REGION_STT=us
VOZ_GOOGLE_MODELO_STT=chirp_3

# ElevenLabs: el plan gratuito sirve para la prueba ciega (uso no comercial).
ELEVENLABS_API_KEY=
ELEVENLABS_MODELO_STT=scribe_v3

# Reconocimiento de voz: google | elevenlabs. Idioma por defecto: es-US (Google) o es (ElevenLabs).
VOZ_STT_PROVEEDOR=google
VOZ_STT_IDIOMA=
# Bajo esta confianza se pide repetir (salvo señal de riesgo).
VOZ_UMBRAL_CONFIANZA=0.5

# ── Enfermero digital (Sprint 4) ─────────────────────────────────────────────────────
# TODO(clinico): plazos definitivos.
MEDICACION_SEGUNDO_AVISO_MIN=30
MEDICACION_SIN_RESPUESTA_MIN=30
# Planificador dentro del servidor (recordatorios y memoria). Con "no", usar cron con
# npm run medicacion:ciclo y npm run memoria:procesar.
PLANIFICADOR=si
